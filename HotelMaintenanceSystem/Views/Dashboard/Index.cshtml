<div class="container-fluid">
    <h2 class="mb-4">Hotel Maintenance Dashboard</h2>
    
    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <h2 class="display-4">@ViewData["TotalOrders"]</h2>
                    <p class="card-text">All maintenance orders</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Completed Orders</h5>
                    <h2 class="display-4">@ViewData["CompletedOrders"]</h2>
                    <p class="card-text">Successfully completed</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Pending Orders</h5>
                    <h2 class="display-4">@((int)ViewData["TotalOrders"] - (int)ViewData["CompletedOrders"])</h2>
                    <p class="card-text">Awaiting completion</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Charts -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Order Status Distribution</h4>
                </div>
                <div class="card-body">
                    <canvas id="orderStatsChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Priority Distribution</h4>
                </div>
                <div class="card-body">
                    <canvas id="priorityStatsChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Quick Actions</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <a asp-controller="Orders" asp-action="Create" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-plus-circle"></i> Create Order
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Orders" asp-action="Index" class="btn btn-info btn-lg w-100">
                                <i class="bi bi-list"></i> View All Orders
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Export" asp-action="ExportExcel" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-file-excel"></i> Export Excel
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Export" asp-action="ExportPdf" class="btn btn-danger btn-lg w-100">
                                <i class="bi bi-file-pdf"></i> Export PDF
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const orderStatsData = @Html.Raw(Json.Serialize(ViewData["OrderStats"]));
        const priorityStatsData = @Html.Raw(Json.Serialize(ViewData["PriorityStats"]));
        
        // Order Status Chart
        new Chart(document.getElementById('orderStatsChart'), {
            type: 'doughnut',
            data: {
                labels: orderStatsData.map(d => d.status || d.Status),
                datasets: [{
                    data: orderStatsData.map(d => d.count || d.Count),
                    backgroundColor: [
                        '#FF6384',
                        '#36A2EB',
                        '#FFCE56',
                        '#4BC0C0',
                        '#9966FF',
                        '#FF9F40',
                        '#FF6384',
                        '#C9CBCF',
                        '#4BC0C0'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
        
        // Priority Chart
        new Chart(document.getElementById('priorityStatsChart'), {
            type: 'bar',
            data: {
                labels: priorityStatsData.map(d => d.priority || d.Priority),
                datasets: [{
                    label: 'Number of Orders',
                    data: priorityStatsData.map(d => d.count || d.Count),
                    backgroundColor: [
                        '#28a745',
                        '#ffc107',
                        '#fd7e14',
                        '#dc3545'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    </script>
}