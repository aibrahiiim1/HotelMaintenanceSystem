<h2>Dashboard</h2>
<div class="row">
    <div class="col-md-6">
        <h4>Order Status Distribution</h4>
        <canvas id="orderStatsChart"></canvas>
    </div>
    <div class="col-md-6">
        <h4>Priority Distribution</h4>
        <canvas id="priorityStatsChart"></canvas>
    </div>
</div>
<div class="row mt-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Orders</h5>
                <p class="card-text">@ViewData["TotalOrders"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Completed Orders</h5>
                <p class="card-text">@ViewData["CompletedOrders"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Pending Orders</h5>
                <p class="card-text">@((int)ViewData["TotalOrders"] - (int)ViewData["CompletedOrders"])</p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const orderStatsData = @Html.Raw(Json.Serialize(ViewData["OrderStats"]));
        const priorityStatsData = @Html.Raw(Json.Serialize(ViewData["PriorityStats"]));
        new Chart(document.getElementById('orderStatsChart'), {
            type: 'pie',
            data: {
                labels: orderStatsData.map(d => d.Status),
                datasets: [{
                    data: orderStatsData.map(d => d.Count),
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0']
                }]
            }
        });
        new Chart(document.getElementById('priorityStatsChart'), {
            type: 'bar',
            data: {
                labels: priorityStatsData.map(d => d.Priority),
                datasets: [{
                    label: 'Count',
                    data: priorityStatsData.map(d => d.Count),
                    backgroundColor: '#36A2EB'
                }]
            }
        });
    </script>
}