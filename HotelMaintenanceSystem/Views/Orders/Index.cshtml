@model IEnumerable<Order>

<h2>Orders</h2>
<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-2">
            <select name="hotelId" class="form-control">
                <option value="">All Hotels</option>
                @foreach (var hotel in ViewData["Hotels"] as List<Hotel>)
                {
                    <option value="@hotel.Id" selected="@(ViewContext.HttpContext.Request.Query["hotelId"] == hotel.Id.ToString())">@hotel.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="departmentId" class="form-control">
                <option value="">All Departments</option>
                @foreach (var dept in ViewData["Departments"] as List<Department>)
                {
                    <option value="@dept.Id" selected="@(ViewContext.HttpContext.Request.Query["departmentId"] == dept.Id.ToString())">@dept.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="statusId" class="form-control">
                <option value="">All Statuses</option>
                @foreach (var status in ViewData["Statuses"] as List<OrderStatus>)
                {
                    <option value="@status.Id" selected="@(ViewContext.HttpContext.Request.Query["statusId"] == status.Id.ToString())">@status.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="startDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["startDate"]" />
        </div>
        <div class="col-md-2">
            <input type="date" name="endDate" class="form-control" value="@ViewContext.HttpContext.Request.Query["endDate"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </div>
</form>
<a asp-action="Create" class="btn btn-primary mb-3">Create New Order</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Hotel</th>
            <th>Department</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Title</td>
                <td>@order.Hotel.Name</td>
                <td>@order.Department.Name</td>
                <td>@order.Status.Name</td>
                <td>@order.Priority</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Details</a>
                    @if (order.StatusId == 1 || order.StatusId == 2)
                    {
                        <form asp-action="Assign" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="text" name="assignedTo" placeholder="Assign to" required />
                            <button type="submit" class="btn btn-sm btn-warning">Assign</button>
                        </form>
                    }
                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@order.Id" />
                        <select name="statusId" required>
                            @foreach (var status in ViewData["Statuses"] as List<OrderStatus>)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </select>
                        <input type="text" name="notes" placeholder="Notes" />
                        <button type="submit" class="btn btn-sm btn-success">Update</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>