@model Order

<h2>Order Details</h2>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Hotel</dt>
    <dd class="col-sm-9">@Model.Hotel.Name</dd>
    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department.Name</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status.Name</dd>
    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>
    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedBy</dd>
    <dt class="col-sm-3">Assigned To</dt>
    <dd class="col-sm-9">@Model.AssignedTo</dd>
    <dt class="col-sm-3">Image</dt>
    <dd class="col-sm-9">@if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="Order Image" style="max-width:200px;" /> }</dd>
</dl>
<h3>History</h3>
<table class="table">
    <thead>
        <tr>
            <th>Status</th>
            <th>Changed By</th>
            <th>Changed At</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var history in Model.Histories.OrderByDescending(h => h.ChangedAt))
        {
            <tr>
                <td>@history.Status.Name</td>
                <td>@history.ChangedBy</td>
                <td>@history.ChangedAt</td>
                <td>@history.Notes</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>