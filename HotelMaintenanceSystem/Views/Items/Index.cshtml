@model IEnumerable<Item>

<h2>Items</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add New Item</a>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Status</th>
            <th>Hotel</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Status</td>
                <td>@item.Hotel.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl)) { <img src="@item.ImageUrl" alt="Item Image" style="max-width:100px;" /> }
                </td>
            </tr>
        }
    </tbody>
</table>